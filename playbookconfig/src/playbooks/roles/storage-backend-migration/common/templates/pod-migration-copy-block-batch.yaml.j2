apiVersion: v1
kind: Pod
metadata:
  name: {{ pod_name }}
  namespace: {{ pod_namespace }}
  labels:
    app: {{ pod_app_label }}
spec:
  tolerations:
    - key: "node-role.kubernetes.io/control-plane"
      operator: "Exists"
      effect: "NoSchedule"
  nodeSelector:
    kubernetes.io/hostname: "{{ inventory_hostname }}"
  containers:
    - name: {{ pod_name }}
      image: {{ images.ceph_config_helper }}
      imagePullPolicy: IfNotPresent
      command: [ "sleep", "infinity" ]
      securityContext:
        privileged: true
      volumeDevices:
{% for pvc_pair in batch_pvc_pairs %}
        - name: src-{{ loop.index0 }}
          devicePath: "/dev/src-block-{{ loop.index0 }}"
        - name: dst-{{ loop.index0 }}
          devicePath: "/dev/dst-block-{{ loop.index0 }}"
{% endfor %}
  imagePullSecrets:
    - name: {{ migration_target | replace('_', '-') }}-migration-registry-local-secret
  volumes:
{% for pvc_pair in batch_pvc_pairs %}
    - name: src-{{ loop.index0 }}
      persistentVolumeClaim:
        claimName: {{ pvc_pair.src_name }}
        readOnly: true
    - name: dst-{{ loop.index0 }}
      persistentVolumeClaim:
        claimName: {{ pvc_pair.dst_name }}
{% endfor %}
