---
# This section includes base Calico installation configuration.
# For more information, see: https://docs.tigera.io/calico/latest/reference/installation/api#operator.tigera.io/v1.Installation
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  kubeletVolumePluginPath: None
  flexVolumePath: {{ k8s_vol_plugin_dir | default('/var/opt/libexec/kubernetes/kubelet-plugins/volume/exec/') }}
  registry: {{ local_registry }}/quay.io
  imagePullSecrets:
    - name: {{ registry_local_secret_name | default('registry-local-secret') }}
  logging:
    cni:
      logSeverity: Warning
  cni:
    type: Calico
    ipam:
      type: Calico
    binDir: {{ kubelet_cni_bin_dir | default('/var/opt/cni/bin') }}
    confDir: /etc/cni/net.d
  calicoNetwork:
    bgp: {{ calico_bgp | default('Enabled') }}
    hostPorts: {{ calico_host_ports | default('Enabled') }}
    multiInterfaceMode: {{ calico_multi_interface_mode | default('None') }}
    linuxDataplane: {{ calico_linux_dataplane | default('Iptables') }}
    windowsDataplane: {{ calico_windows_dataplane | default('Disabled') }}
{% if calico_mtu is defined %}
    mtu: {{ calico_mtu }}
{% endif %}
    ipPools:
{% if cluster_network_ipv4 %}
      - name: default-ipv4-ippool
        blockSize: {{ calico_ippool_block_size_v4 | default(26) }}
        cidr: {{ cluster_network_ipv4 }}
        encapsulation: {{ calico_encapsulation | default('None') }}
        natOutgoing: Enabled
        nodeSelector: all()
{% endif %}
{% if cluster_network_ipv6 %}
      - name: default-ipv6-ippool
        blockSize: {{ calico_ippool_block_size_v6 | default(122) }}
        cidr: {{ cluster_network_ipv6 }}
        encapsulation: {{ calico_encapsulation | default('None') }}
        natOutgoing: Enabled
        nodeSelector: all()
{% endif %}
{% if cluster_network_ipv4 %}
    nodeAddressAutodetectionV4:
      canReach: {{ calico_ip4_autodetect_host }}
{% endif %}
{% if cluster_network_ipv6 %}
    nodeAddressAutodetectionV6:
      canReach: {{ calico_ip6_autodetect_host }}
{% endif %}
  typhaDeployment:
    spec:
      template:
        spec:
          nodeSelector:
            kubernetes.io/os: linux
          # NOTE: setting tolerations here overrides the operator defaults, so
          # the control-plane/master NoSchedule tolerations must be kept.
          tolerations:
            - key: node-role.kubernetes.io/control-plane
              effect: NoSchedule
              operator: Exists
            - key: node-role.kubernetes.io/master
              effect: NoSchedule
              operator: Exists
            - key: node.kubernetes.io/not-ready
              effect: NoSchedule
              operator: Exists
            # ride through the brief bootstrap kubelet-down window
            # instead of being evicted after the 30s default not-ready toleration.
            - key: node.kubernetes.io/not-ready
              effect: NoExecute
              operator: Exists
              tolerationSeconds: {{ calico_not_ready_toleration_seconds | default(300) }}
            - key: node.kubernetes.io/unreachable
              effect: NoExecute
              operator: Exists
              tolerationSeconds: {{ calico_not_ready_toleration_seconds | default(300) }}
  # give calico-kube-controllers the same protection. It has no
  # dedicated toleration by default, so it inherits the 30s not-ready toleration
  # and is the first pod evicted, then crash-loops against the apiserver VIP
  # until the datapath is back.
  calicoKubeControllersDeployment:
    spec:
      template:
        spec:
          tolerations:
            - key: node-role.kubernetes.io/control-plane
              effect: NoSchedule
              operator: Exists
            - key: node-role.kubernetes.io/master
              effect: NoSchedule
              operator: Exists
            - key: node.kubernetes.io/not-ready
              effect: NoExecute
              operator: Exists
              tolerationSeconds: {{ calico_not_ready_toleration_seconds | default(300) }}
            - key: node.kubernetes.io/unreachable
              effect: NoExecute
              operator: Exists
              tolerationSeconds: {{ calico_not_ready_toleration_seconds | default(300) }}
  calicoNodeDaemonSet:
    spec:
      template:
        spec:
          containers:
            - name: calico-node
              resources:
                requests:
                  cpu: "0"

