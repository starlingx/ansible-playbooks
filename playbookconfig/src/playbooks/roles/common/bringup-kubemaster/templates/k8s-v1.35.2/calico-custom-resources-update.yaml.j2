---
# Installation CR for Calico upgrade/migration.
# Provides explicit nodeAddressAutodetection to prevent the operator
# from defaulting to firstFound on IPv6-only systems.
# For more information, see: https://docs.tigera.io/calico/3.31/operations/operator-migration
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  kubeletVolumePluginPath: None
  registry: {{ local_registry }}/quay.io
  imagePullSecrets:
    - name: {{ registry_local_secret_name | default('registry-local-secret') }}
  calicoNetwork:
{% if cluster_network_ipv4 %}
    nodeAddressAutodetectionV4:
      canReach: {{ calico_ip4_autodetect_host }}
{% endif %}
{% if cluster_network_ipv6 %}
    nodeAddressAutodetectionV6:
      canReach: {{ calico_ip6_autodetect_host }}
{% endif %}
  cni:
    type: Calico
    ipam:
      type: Calico
    binDir: {{ kubelet_cni_bin_dir | default('/var/opt/cni/bin') }}
    confDir: /etc/cni/net.d
  typhaDeployment:
    spec:
      template:
        spec:
          nodeSelector:
            kubernetes.io/os: linux
          # NOTE: setting tolerations here overrides the operator defaults, so
          # the control-plane/master NoSchedule tolerations must be kept.
          tolerations:
            - key: node-role.kubernetes.io/control-plane
              effect: NoSchedule
              operator: Exists
            - key: node-role.kubernetes.io/master
              effect: NoSchedule
              operator: Exists
            - key: node.kubernetes.io/not-ready
              effect: NoSchedule
              operator: Exists
            # Ride through a brief NotReady window (e.g. kubelet restart during
            # the k8s upgrade/migration) instead of being evicted after the 30s
            # default not-ready toleration. Kept consistent with the bootstrap
            # template (calico-custom-resources.yaml.j2).
            - key: node.kubernetes.io/not-ready
              effect: NoExecute
              operator: Exists
              tolerationSeconds: {{ calico_not_ready_toleration_seconds | default(300) }}
            - key: node.kubernetes.io/unreachable
              effect: NoExecute
              operator: Exists
              tolerationSeconds: {{ calico_not_ready_toleration_seconds | default(300) }}
  # Give calico-kube-controllers the same protection. It has no dedicated
  # toleration by default, so it inherits the 30s not-ready toleration and is
  # the first pod evicted, then crash-loops against the apiserver VIP until the
  # datapath is back. Kept consistent with the bootstrap template.
  calicoKubeControllersDeployment:
    spec:
      template:
        spec:
          tolerations:
            - key: node-role.kubernetes.io/control-plane
              effect: NoSchedule
              operator: Exists
            - key: node-role.kubernetes.io/master
              effect: NoSchedule
              operator: Exists
            - key: node.kubernetes.io/not-ready
              effect: NoExecute
              operator: Exists
              tolerationSeconds: {{ calico_not_ready_toleration_seconds | default(300) }}
            - key: node.kubernetes.io/unreachable
              effect: NoExecute
              operator: Exists
              tolerationSeconds: {{ calico_not_ready_toleration_seconds | default(300) }}
