---
# Installation CR for Calico upgrade/migration.
# Provides explicit nodeAddressAutodetection to prevent the operator
# from defaulting to firstFound on IPv6-only systems.
# For more information, see: https://docs.tigera.io/calico/3.31/operations/operator-migration
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  kubeletVolumePluginPath: None
  registry: {{ local_registry }}/quay.io
  imagePullSecrets:
    - name: {{ registry_local_secret_name | default('registry-local-secret') }}
  calicoNetwork:
{% if cluster_network_ipv4 %}
    nodeAddressAutodetectionV4:
      canReach: {{ calico_ip4_autodetect_host }}
{% endif %}
{% if cluster_network_ipv6 %}
    nodeAddressAutodetectionV6:
      canReach: {{ calico_ip6_autodetect_host }}
{% endif %}
  cni:
    type: Calico
    ipam:
      type: Calico
    binDir: {{ kubelet_cni_bin_dir | default('/var/opt/cni/bin') }}
    confDir: /etc/cni/net.d
  typhaDeployment:
    spec:
      template:
        spec:
          nodeSelector:
            kubernetes.io/os: linux
            node-role.kubernetes.io/control-plane: ""
          tolerations:
            - key: node-role.kubernetes.io/control-plane
              effect: NoSchedule
              operator: Exists
            - key: node-role.kubernetes.io/master
              effect: NoSchedule
              operator: Exists
            - key: node.kubernetes.io/not-ready
              effect: NoSchedule
              operator: Exists
