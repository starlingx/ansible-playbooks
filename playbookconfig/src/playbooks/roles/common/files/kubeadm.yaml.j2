apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ apiserver_advertise_address }}
  bindPort: 16443
nodeRegistration:
  criSocket: unix:///var/run/containerd/containerd.sock
  # configure kubeadm to not apply the default
  # taint "node-role.kubernetes.io/master:NoSchedule" to control plane nodes
  taints: {{ kubelet_taints }}
  kubeletExtraArgs:
{% for item in kubelet_extra_args | dict2items(key_name='name', value_name='value') %}
    - name: {{ item.name | string | to_json }}
      value: {{ item.value | string | to_json }}
{% endfor %}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
encryptionAlgorithm: ECDSA-P384
apiServer:
  certSANs:
  {{ apiserver_cert_list | to_nice_yaml(width=512) | indent(2, false) }}
  extraArgs:
{% for item in apiserver_extra_args | dict2items(key_name='name', value_name='value') %}
    - name: {{ item.name | string | to_json }}
      value: {{ item.value | string | to_json }}
{% endfor %}
  extraVolumes:
{% for volume in apiserver_extra_volumes %}
    - name: "{{ volume.name }}"
      mountPath: {{ volume.mountPath }}
{% if volume.pathType == 'File' %}
      hostPath:  {{ volume.hostPath }}
      pathType: File
{% else %}
      hostPath: {{ volume.mountPath }}
      pathType: DirectoryOrCreate
{% endif %}
{% if volume.readOnly == true %}
      readOnly: true
{% else %}
      readOnly: false
{% endif %}
{% endfor %}
controllerManager:
  extraArgs:
{% for item in controllermanager_extra_args | dict2items(key_name='name', value_name='value') %}
    - name: {{ item.name | string | to_json }}
      value: {{ item.value | string | to_json }}
{% endfor %}
  extraVolumes:
{% for volume in controllermanager_extra_volumes %}
    - name: "{{ volume.name }}"
      mountPath: {{ volume.mountPath }}
{% if volume.pathType == 'File' %}
      hostPath:  {{ volume.hostPath }}
      pathType: File
{% else %}
      hostPath: {{ volume.mountPath }}
      pathType: DirectoryOrCreate
{% endif %}
{% if volume.readOnly == true %}
      readOnly: true
{% else %}
      readOnly: false
{% endif %}
{% endfor %}
scheduler:
  extraArgs:
{% for item in scheduler_extra_args | dict2items(key_name='name', value_name='value') %}
    - name: {{ item.name | string | to_json }}
      value: {{ item.value | string | to_json }}
{% endfor %}
  extraVolumes:
{% for volume in scheduler_extra_volumes %}
    - name: "{{ volume.name }}"
      mountPath: {{ volume.mountPath }}
{% if volume.pathType == 'File' %}
      hostPath:  {{ volume.hostPath }}
      pathType: File
{% else %}
      hostPath: {{ volume.mountPath }}
      pathType: DirectoryOrCreate
{% endif %}

{% if volume.readOnly == true %}
      readOnly: true
{% else %}
      readOnly: false
{% endif %}
{% endfor %}
controlPlaneEndpoint: {{ controlplane_endpoint }}
etcd:
  external:
    # FR-04: kube-apiserver is configured with every available etcd endpoint so
    # it can spread reads and fail over if a member is down. At bootstrap only
    # the floating member exists, so etcd_endpoints defaults to the single
    # floating endpoint; the fixed members are appended at runtime once they
    # join the cluster (FR-03), via change_k8s_control_plane_params.py.
    endpoints:
{% for endpoint in etcd_endpoints | default([etcd_endpoint]) %}
    - {{ endpoint }}
{% endfor %}
    caFile: /etc/etcd/ca.crt
    certFile: /etc/kubernetes/pki/apiserver-etcd-client.crt
    keyFile: /etc/kubernetes/pki/apiserver-etcd-client.key
dns:
  imageRepository: {{ image_repository + '/coredns'}}
imageRepository: {{ image_repository }}
kubernetesVersion: {{ kubernetes_long_version }}
networking:
  {{networking_configurations | to_nice_yaml(width=512) | indent(2, false)}}
proxy: {}
---
kind: KubeletConfiguration
apiVersion: kubelet.config.k8s.io/v1beta1
{{kubelet_configurations | to_nice_yaml(width=512) | indent(0, false)}}
